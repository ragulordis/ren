rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Only authenticated property owners can upload listing images
    match /property_images/{propertyId}/{allPaths=**} {
      // Pending or rejected listing media must not be publicly enumerable. The
      // owner can still preview it while the listing is under review.
      allow read: if firestore.get(/databases/(default)/documents/properties/$(propertyId)).data.moderationStatus == 'ACTIVE'
                  || (request.auth != null
                      && firestore.get(/databases/(default)/documents/properties/$(propertyId)).data.ownerId == request.auth.uid);
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)')
                   && firestore.get(/databases/(default)/documents/properties/$(propertyId)).data.ownerId == request.auth.uid;
    }

    match /properties/{propertyId}/{allPaths=**} {
      allow read: if firestore.get(/databases/(default)/documents/properties/$(propertyId)).data.moderationStatus == 'ACTIVE'
                  || (request.auth != null
                      && firestore.get(/databases/(default)/documents/properties/$(propertyId)).data.ownerId == request.auth.uid);
      allow write: if request.auth != null
                   && request.resource.size < 10 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)')
                   && firestore.get(/databases/(default)/documents/properties/$(propertyId)).data.ownerId == request.auth.uid;
    }

    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/(jpeg|jpg|png|webp)');
    }
  }
}
