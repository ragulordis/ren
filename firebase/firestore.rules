rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User public profiles (contains only public info: displayName, photoUrl, role, accountStatus)
    match /users/{userId} {
      allow read: if isAuthenticated();
      // Server-authoritative role: client can only create initial BUYER role, cannot escalate role on update
      allow create: if isOwner(userId)
                    && (!('role' in request.resource.data) || request.resource.data.role == 'BUYER')
                    && (!('verificationLevel' in request.resource.data) || request.resource.data.verificationLevel == 0)
                    && (!('accountStatus' in request.resource.data) || request.resource.data.accountStatus == 'ACTIVE');
      allow update: if isOwner(userId)
                    // Role and verificationLevel are locked from client tampering
                    && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role)
                    && (!('verificationLevel' in request.resource.data) || request.resource.data.verificationLevel == resource.data.verificationLevel)
                    && (!('accountStatus' in request.resource.data) || request.resource.data.accountStatus == resource.data.accountStatus);
      allow delete: if false; // Deletion handled via secure account deletion cloud function
    }

    // User private profiles - accessible ONLY by the profile owner (contains email, phone, private prefs)
    match /users/{userId}/private/profile {
      allow read, write: if isOwner(userId);
    }

    // User saved properties
    match /users/{userId}/saved/{propertyId} {
      allow read, write: if isOwner(userId);
    }

    // Public properties
    match /properties/{propertyId} {
      allow read: if true; // Public marketplace listing
      allow create: if isAuthenticated()
                    && request.resource.data.ownerId == request.auth.uid
                    && (!('verificationLevel' in request.resource.data) || request.resource.data.verificationLevel == 0)
                    && (!('moderationStatus' in request.resource.data) || request.resource.data.moderationStatus == 'PENDING');
      allow update: if isAuthenticated()
                    && resource.data.ownerId == request.auth.uid
                    && request.resource.data.ownerId == resource.data.ownerId
                    // Client cannot self-approve or elevate verification level
                    && request.resource.data.verificationLevel == resource.data.verificationLevel
                    && request.resource.data.moderationStatus == resource.data.moderationStatus
                    // Protect server-authoritative counter metrics from client escalation
                    && (!('viewsCount' in request.resource.data) || request.resource.data.viewsCount == resource.data.viewsCount)
                    && (!('savedCount' in request.resource.data) || request.resource.data.savedCount == resource.data.savedCount)
                    && (!('messagesCount' in request.resource.data) || request.resource.data.messagesCount == resource.data.messagesCount)
                    && (!('interestedBuyersCount' in request.resource.data) || request.resource.data.interestedBuyersCount == resource.data.interestedBuyersCount);
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // Scheduled visits
    match /visits/{visitId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid
      );
      allow create: if isAuthenticated()
                    && request.resource.data.buyerId == request.auth.uid
                    && request.resource.data.status == 'Requested';
      allow update: if isAuthenticated() && (
        // Buyer or Seller can transition based on authoritative state machine:
        // Immutable IDs & core attributes:
        request.resource.data.buyerId == resource.data.buyerId
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.propertyId == resource.data.propertyId
        && (
          // Seller can confirm or decline requested visits
          (request.auth.uid == resource.data.sellerId && resource.data.status == 'Requested' && request.resource.data.status in ['Confirmed', 'Declined'])
          ||
          // Buyer can cancel requested or confirmed visits
          (request.auth.uid == resource.data.buyerId && resource.data.status in ['Requested', 'Confirmed'] && request.resource.data.status == 'Cancelled')
          ||
          // Seller can complete confirmed visits
          (request.auth.uid == resource.data.sellerId && resource.data.status == 'Confirmed' && request.resource.data.status == 'Completed')
        )
      );
      allow delete: if isAuthenticated() && resource.data.buyerId == request.auth.uid;
    }

    // Conversations and messages
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants
      );
      // Conversation creation must be bound to seller (property owner) and the initiating buyer
      allow create: if isAuthenticated()
                    && (request.auth.uid in request.resource.data.participants)
                    && (request.resource.data.participants.size() <= 2)
                    && (
                      (
                        'propertyId' in request.resource.data
                        && get(/databases/$(database)/documents/properties/$(request.resource.data.propertyId)).data.ownerId in request.resource.data.participants
                      )
                      ||
                      (
                        get(/databases/$(database)/documents/properties/$(conversationId)).data.ownerId in request.resource.data.participants
                      )
                    );
      // Participants cannot be arbitrarily added or escalated post-creation
      allow update: if isAuthenticated()
                    && request.auth.uid in resource.data.participants
                    && request.resource.data.participants == resource.data.participants;

      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
        );
        allow create: if isAuthenticated()
                      && request.resource.data.senderId == request.auth.uid
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }

    // Moderation reports
    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if false; // Only admin backend can access
    }
  }
}
